# caddy/Caddyfile
{$SEARXNG_HOSTNAME:localhost} {
    reverse_proxy searxng:8080
    
    # Enable compression
    encode gzip
    
    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
    }
}

